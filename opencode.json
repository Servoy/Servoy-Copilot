{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [
      "skills"
    ]
  },
  "commands": {
    "sdd": {
      "description": "Run full Spec-Driven Development pipeline for a Jira issue",
      "template": "Load the 'sdd' skill and execute the full SDD pipeline for: $ARGUMENTS"
    },
    "update-opencode": {
      "description": "Update the embedded opencode CLI, with an API break-check",
      "template": "Load the 'update-opencode' skill and run its full procedure to update the embedded opencode CLI. Target version (if the user gave one): $ARGUMENTS"
    }
  },
  "mcp": {
    "servers": {
      "angular-cli": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@angular/cli@22",
          "mcp"
        ],
        "cwd": "bundles/com.servoy.eclipse.opencode/webui"
      },
      "time": {
        "type": "remote",
        "url": "http://localhost:8087/mcp/time"
      },
      "eclipse-runner": {
        "type": "remote",
        "url": "http://localhost:8087/mcp/eclipse-runner"
      },
      "memory": {
        "type": "remote",
        "url": "http://localhost:8087/mcp/memory",
        "codemode": false
      },
      "eclipse-coder": {
        "type": "remote",
        "url": "http://localhost:8087/mcp/eclipse-coder"
      },
      "eclipse-ide": {
        "type": "remote",
        "url": "http://localhost:8087/mcp/eclipse-ide"
      },
      "eclipse-git": {
        "type": "remote",
        "url": "http://localhost:8087/mcp/eclipse-git"
      },
      "eclipse-pde": {
        "type": "remote",
        "url": "http://localhost:8087/mcp/eclipse-pde"
      },
      "eclipse-context": {
        "type": "remote",
        "url": "http://localhost:8087/mcp/eclipse-context"
      }
    }
  }
}
