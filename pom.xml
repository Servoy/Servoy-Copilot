<?xml version="1.0" encoding="UTF-8"?>
<project
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
    xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.servoy</groupId>
    <artifactId>com.servoy.eclipse.servoypilot.parent</artifactId>
    <packaging>pom</packaging>
    <version>2026.3.1-SNAPSHOT</version>

    <properties>
        <tycho-version>5.0.3</tycho-version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <servoy.url>https://build.servoy.com/latest/servoy_lts_2026/update_site/</servoy.url>
        <servoy.install.tarball.for.appserver>/data/www/latest/servoy_lts_2026/servoy_linux.tar.gz</servoy.install.tarball.for.appserver>
        <!-- Skill-test run (SVY-21366). The CI job overrides these with -D; defaults here
             keep the properties from resolving to literal '${...}' when unset (which would
             reach the forked test JVM as garbage). run=false means the scenario ignition
             (SkillTestCiRunnerTest) is skipped unless the job opts in. -->
        <servoy.skilltest.run>false</servoy.skilltest.run>
        <servoy.skilltest.baselines></servoy.skilltest.baselines>
        <servoy.skilltest.outputDir>${project.build.directory}/skilltest-reports</servoy.skilltest.outputDir>
        <servoy.skilltest.cloudUser></servoy.skilltest.cloudUser>
        <servoy.skilltest.cloudPass></servoy.skilltest.cloudPass>
        <!-- Kiro key path (preferred over cloud login). The CI job sets this to the Kiro
             'ksk_...' key. It is passed to the forked JVM as -DGENAI_API_KEY so the
             OpencodeFolderCreatorJob gate (which only checks GENAI_API_KEY is non-blank)
             passes; the ACTUAL Kiro auth is done by the @servoy/opencode-kiro-auth plugin,
             which reads the KIRO_API_KEY *environment* variable (set in the Jenkins shell,
             inherited by the surefire fork + opencode child) - not a -D. Same value in both.
             With GENAI_API_KEY set, CloudLogin returns early, so no 401 cloud login.
             skillsZip points at the non-production skills bundle (skill4servoy's
             .opencode-shippable, zipped at build time with opencode_servoy.json as
             opencode.json) so the run does not verify production skills. -->
        <servoy.skilltest.kiroApiKey></servoy.skilltest.kiroApiKey>
        <servoy.skilltest.skillsZip></servoy.skilltest.skillsZip>
        <!-- opencode server readiness wait (ms). First CI run downloads node + npm installs
             the pinned opencode cli, which can exceed the old 180s. Default 420s. -->
        <servoy.skilltest.opencodeWaitMs>420000</servoy.skilltest.opencodeWaitMs>
    </properties>

    <repositories>
         <repository>
            <id>servoy</id>
            <url>${servoy.url}</url>
            <layout>p2</layout>
        </repository>
    </repositories>
    
    <build>
        <plugins>
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>tycho-maven-plugin</artifactId>
                <version>${tycho-version}</version>
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>target-platform-configuration</artifactId>
                <version>${tycho-version}</version>
                <configuration>
                    <target>
                        <artifact>
                            <groupId>com.servoy</groupId>
                            <artifactId>com.servoy.eclipse.servoypilot.target</artifactId>
                            <version>${project.parent.version}</version>
                        </artifact>
                    </target>
                    <pomDependencies>consider</pomDependencies>
                    <dependency-resolution>
                        <optionalDependencies>ignore</optionalDependencies>
                    </dependency-resolution>
                    <environments>
                        <environment>
                            <os>linux</os>
                            <ws>gtk</ws>
                            <arch>x86_64</arch>
                        </environment>
                        <environment>
                            <os>win32</os>
                            <ws>win32</ws>
                            <arch>x86_64</arch>
                        </environment>
                        <environment>
                            <os>win32</os>
                            <ws>win32</ws>
                            <arch>aarch64</arch>
                        </environment>
                        <environment>
                            <os>macosx</os>
                            <ws>cocoa</ws>
                            <arch>x86_64</arch>
                        </environment>
                        <environment>
                            <os>macosx</os>
                            <ws>cocoa</ws>
                            <arch>aarch64</arch>
                        </environment>
                    </environments>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>tycho-compiler-plugin</artifactId>
                <version>${tycho-version}</version>
                <configuration>
                    <compilerArgument>-warn:none</compilerArgument>
                    <useProjectSettings>false</useProjectSettings>
                    <useJDK>BREE</useJDK>
                    <deriveReleaseCompilerArgumentFromTargetLevel>false</deriveReleaseCompilerArgumentFromTargetLevel>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>tycho-versions-plugin</artifactId>
                <version>${tycho-version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jarsigner-plugin</artifactId>
                <version>3.0.0.s1</version>
                <executions>
                    <execution>
                        <id>sign</id>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>tycho-p2-plugin</artifactId>
                <version>${tycho-version}</version>
                <executions>
                    <execution>
                        <id>p2-metadata</id>
                        <goals>
                            <goal>p2-metadata</goal>
                        </goals>
                        <phase>package</phase>
                    </execution>
                </executions>
                <configuration>
                    <defaultP2Metadata>true</defaultP2Metadata>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <modules>
        <module>launch_target_aiplugin</module>
        <module>bundles/com.servoy.eclipse.developer.mcp</module>
        <module>bundles/com.servoy.eclipse.opencode</module>
        <module>bundles/com.servoy.eclipse.opencode.skilltest</module>
        <module>features/com.servoy.eclipse.servoypilot.feature</module>
        <module>features/com.servoy.eclipse.opencode.skilltest.feature</module>
        <module>repository.site_aiplugin</module>
        <module>repository.site_skilltest</module>
        <module>tests/com.servoy.eclipse.opencode.tests</module>
        <module>tests/com.servoy.eclipse.developer.mcp.tests</module>
        <module>tests/com.servoy.eclipse.opencode.skilltest.tests</module>
    </modules>

</project>
