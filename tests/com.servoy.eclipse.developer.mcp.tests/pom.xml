<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <prerequisites>
        <maven>3.9.0</maven>
    </prerequisites>
    <parent>
        <groupId>com.servoy</groupId>
        <artifactId>com.servoy.eclipse.servoypilot.parent</artifactId>
        <version>2026.3.1-SNAPSHOT</version>
        <relativePath>../..</relativePath>
    </parent>
    <artifactId>com.servoy.eclipse.developer.mcp.tests</artifactId>
    <packaging>eclipse-test-plugin</packaging>
    <build>
        <!-- Tycho compiles src/test/java (source.. in build.properties) into target/classes; plain surefire looks in target/test-classes by default -->
        <testOutputDirectory>${project.build.directory}/classes</testOutputDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jarsigner-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <!-- JaCoCo code coverage (SVY: coverage recipe).
                 prepare-agent writes the -javaagent:... string into the property named
                 'jacocoArgLine' (NOT the default 'argLine', because this module sets its own
                 literal surefire <argLine> and we want the concatenation to be explicit).
                 The surefire <argLine> below references it as @{jacocoArgLine} (late
                 evaluation), so the agent actually reaches the forked test JVM - that is the
                 step the servoy-eclipse attempt was missing, and why no jacoco.exec was ever
                 written there. The RESULT is target/jacoco.exec with the runtime coverage data.

                 The HTML/XML report is NOT generated here: this test plugin Require-Bundles the
                 production bundle (com.servoy.eclipse.developer.mcp), so the classes exercised
                 at runtime belong to that bundle, not to this module's target/classes (which
                 holds only the compiled test classes). The jacoco 'report' goal can only
                 analyze the current module's own build output - it has no classDirectories/
                 sourceDirectories parameters - so the report is produced in the production
                 bundle's own module, pointed at this exec file, as a second step (see the
                 production bundle pom / the recipe). -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.13</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <propertyName>jacocoArgLine</propertyName>
                            <destFile>${project.build.directory}/jacoco.exec</destFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- plainjunit tests run on a flat classpath (like Eclipse "Run as JUnit"), without an OSGi runtime -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin-version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.maven.surefire</groupId>
                        <artifactId>surefire-junit-platform</artifactId>
                        <version>${surefire-plugin-version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <!-- the eclipse-test-plugin lifecycle only binds tycho-surefire:test, so bind plain surefire explicitly -->
                    <execution>
                        <id>plainjunit-tests</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!-- Plain unit tests: everything under the plainjunit package. There are no
                         @Suite aggregator classes - tests are selected by package. -->
                    <includes>
                        <include>**/plainjunit/**/*.java</include>
                    </includes>
                    <!-- @{jacocoArgLine} is the JaCoCo agent, set by prepare-agent above. Late
                         (@{...}) evaluation so the resolved -javaagent reaches the fork. -->
                    <argLine>@{jacocoArgLine} -Xms128m -Xmx512m -ea --add-exports=java.base/sun.security.x509=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
            <!-- tycho-surefire always starts an OSGi runtime; it is only used by the integration profile -->
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>tycho-surefire-plugin</artifactId>
                <version>${tycho-version}</version>
                <configuration>
                    <skip>true</skip>
                    <!-- Force the JUnit Platform (junit6) provider. The Eclipse target platform
                         always contributes org.junit (JUnit 4) to the test runtime, so Tycho's
                         automatic framework detection would otherwise pick the junit4 provider
                         and report "No tests found" for these pure-Jupiter tests. -->
                    <providerHint>junit6</providerHint>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>win32-x86_64</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <arch.extension.plugin>com.servoy.eclipse.nodejs.win32.win32.x86_64</arch.extension.plugin>
            </properties>
        </profile>
        <profile>
            <id>win32-aarch64</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <arch.extension.plugin>com.servoy.eclipse.nodejs.win32.win32.aarch64</arch.extension.plugin>
            </properties>
        </profile>
        <profile>
            <id>linux-x86_64</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <arch.extension.plugin>com.servoy.eclipse.nodejs.linux.gtk.x86_64</arch.extension.plugin>
            </properties>
        </profile>
        <profile>
            <id>mac-aarch64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <arch.extension.plugin>com.servoy.eclipse.nodejs.macosx.aarch64</arch.extension.plugin>
            </properties>
        </profile>
        <profile>
            <id>integration</id>
            <properties>
                <servoy_install>${project.basedir}/testresources/servoy_lts_extracted</servoy_install>
                <!-- additionalTestArgLine is the tycho/jacoco double-indirection token (the documented
                     Lorenzo Bettini pattern). It holds the LITERAL string ${tycho.testArgLine}, which
                     Maven does NOT expand here - it is expanded only when the tycho-surefire <argLine>
                     dereferences ${additionalTestArgLine}, at mojo-execution time, by which point
                     jacoco:prepare-agent has set tycho.testArgLine to the -javaagent arg. This extra
                     level of indirection is REQUIRED: tycho resolves a property that argLine references
                     directly (e.g. ${tycho.testArgLine}) too early - before prepare-agent runs - so a
                     direct reference, or an empty default, would freeze an empty value and the agent
                     would never reach the fork (which is exactly why the first attempt wrote no exec). -->
                <additionalTestArgLine>${tycho.testArgLine}</additionalTestArgLine>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>create-artifacts-xml</id>
                                <phase>pre-integration-test</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <mkdir dir="${project.build.directory}/work"/>
                                        <touch file="${project.build.directory}/work/artifacts.xml"/>
                                    </target>
                                </configuration>
                            </execution>
                            <execution>
                                <id>prepare-servoy-install</id>
                                <phase>generate-test-resources</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target xmlns:if="ant:if" xmlns:unless="ant:unless">
                                        <property name="tarball" value="${servoy.install.tarball.for.appserver}"/>
                                        <property name="extract_dir" value="${project.basedir}/testresources/servoy_lts_extracted"/>
                                        <property name="timestamp_file" value="${project.basedir}/testresources/servoy_lts_extracted.timestamp"/>

                                        <!-- Only act if the tarball exists (i.e. we are on Jenkins) -->
                                        <available file="${tarball}" property="tarball_exists"/>

                                        <!-- Check if the timestamp file is at least as new as the tarball -->
                                        <uptodate property="extraction_current"
                                            srcfile="${tarball}" targetfile="${timestamp_file}"
                                            if:set="tarball_exists"/>

                                        <!-- If tarball exists but extraction is stale/missing: re-extract -->
                                        <sequential if:set="tarball_exists" unless:set="extraction_current">
                                            <delete dir="${extract_dir}" quiet="true"/>
                                            <delete file="${timestamp_file}" quiet="true"/>
                                            <mkdir dir="${extract_dir}"/>
                                            <untar src="${tarball}" dest="${extract_dir}" compression="gzip">
                                                <patternset>
                                                    <include name="application_server/**"/>
                                                    <exclude name="application_server/postgres_db/**"/>
                                                </patternset>
                                            </untar>
                                            <!-- Stamp timestamp_file with tarball's own mtime -->
                                            <exec executable="touch">
                                                <arg value="-r"/>
                                                <arg value="${tarball}"/>
                                                <arg value="${timestamp_file}"/>
                                            </exec>
                                        </sequential>

                                        <!-- Use non-default tomcat ports so the developer started by the tests does not clash with
                                             another Servoy/tomcat already bound to 8080/8006 on the Jenkins agent.
                                             Only done when the tarball is present (Jenkins), and then mandatory: the build fails if the
                                             ports cannot be changed. Applied on every run, also when the extraction is up-to-date. -->
                                        <property name="server_xml" value="${extract_dir}/application_server/server/conf/server.xml"/>
                                        <available file="${server_xml}" property="server_xml_exists"/>
                                        <fail message="Cannot set the tomcat test ports: ${server_xml} does not exist"
                                            if:set="tarball_exists" unless:set="server_xml_exists"/>
                                        <sequential if:set="tarball_exists">
                                            <replaceregexp file="${server_xml}"
                                                match="(?&lt;=&lt;Connector\s{1,10}port=&quot;)\d+(?=&quot;\s+protocol=&quot;HTTP/1\.1&quot;)"
                                                replace="${servoy.test.http.port}"/>
                                            <replaceregexp file="${server_xml}"
                                                match="(?&lt;=&lt;Server\s{1,10}port=&quot;)\d+(?=&quot;)"
                                                replace="${servoy.test.shutdown.port}"/>
                                            <loadfile property="server_xml_content" srcFile="${server_xml}"/>
                                            <fail message="Failed to set the tomcat http port to ${servoy.test.http.port} in ${server_xml}">
                                                <condition>
                                                    <not>
                                                        <matches string="${server_xml_content}" pattern="(?s).*&lt;Connector\s+port=&quot;${servoy.test.http.port}&quot;\s+protocol=&quot;HTTP/1\.1&quot;.*"/>
                                                    </not>
                                                </condition>
                                            </fail>
                                            <fail message="Failed to set the tomcat shutdown port to ${servoy.test.shutdown.port} in ${server_xml}">
                                                <condition>
                                                    <not>
                                                        <matches string="${server_xml_content}" pattern="(?s).*&lt;Server\s+port=&quot;${servoy.test.shutdown.port}&quot;.*"/>
                                                    </not>
                                                </condition>
                                            </fail>
                                        </sequential>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>${surefire-plugin-version}</version>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                    <!-- JaCoCo code coverage for the integrationpde PDE tests (Phase 2).
                         This is a SEPARATE prepare-agent from the plainjunit one in the base build.
                         For an eclipse-test-plugin, jacoco:prepare-agent writes the -javaagent string
                         into the DEFAULT property tycho.testArgLine (not argLine) - we keep that default
                         here and only redirect its destFile to a SEPARATE jacoco-it.exec so it never
                         collides with the unit jacoco.exec. tycho-surefire would normally pick up
                         tycho.testArgLine automatically, but this module sets a custom <argLine>, which
                         would otherwise overwrite it. The tycho pitfall (and the reason the first
                         attempt wrote no exec): a <argLine> referencing a property is resolved by tycho
                         BEFORE jacoco:prepare-agent runs, so a property given an empty default simply
                         freezes empty. The documented fix is one more level of indirection via the
                         profile's additionalTestArgLine=${tycho.testArgLine} property (see above), which
                         the tycho-surefire <argLine> references and which expands late. The agent
                         flushes jacoco-it.exec on the workbench JVM's clean shutdown (dumponexit,
                         default true). The exec is merged with jacoco.exec and reported in the
                         production bundle's module (see its coverage-report profile). -->
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>0.8.13</version>
                        <executions>
                            <execution>
                                <id>jacoco-prepare-agent-it</id>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                                <configuration>
                                    <!-- default propertyName for eclipse-test-plugin is tycho.testArgLine;
                                         only the destFile is redirected so it does not collide with the
                                         plainjunit jacoco.exec -->
                                    <destFile>${project.build.directory}/jacoco-it.exec</destFile>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.eclipse.tycho</groupId>
                        <artifactId>tycho-surefire-plugin</artifactId>
                        <version>${tycho-version}</version>
                        <configuration>
                            <skip>false</skip>
                            <!-- Force the JUnit Platform (junit6) provider; the Eclipse target
                                 platform always contributes JUnit 4, so auto-detection would
                                 otherwise pick junit4 and find no tests. Tests are selected by
                                 package (everything under integrationpde); there are no @Suite
                                 aggregator classes. -->
                            <providerHint>junit6</providerHint>
                            <includes>
                                <include>**/integrationpde/**/*.java</include>
                            </includes>
                            <useUIHarness>true</useUIHarness>
                            <useUIThread>false</useUIThread>
                            <product>com.servoy.eclipse.core.ide</product>
                            <application>org.eclipse.ui.ide.workbench</application>
                            <!-- ${additionalTestArgLine} carries the JaCoCo agent (see the jacoco
                                 plugin above); prepended so it reaches the forked workbench JVM. -->
                            <argLine>${additionalTestArgLine} -Xms256m -Xmx2048m -ea --add-exports=java.base/sun.security.x509=ALL-UNNAMED -Dorg.osgi.framework.system.packages.extra=sun.security.x509 -Dservoy.cloud.skipCheckout=true -Dservoy.application_server.dir=${servoy_install}/application_server -Dproperty-file=${project.basedir}/testresources/servoy.properties -Dchromium.integration.eclipse.disable=true -Dorg.eclipse.ui.testing=true</argLine>
                            <deleteOsgiDataDirectory>false</deleteOsgiDataDirectory>
                            <bundleStartLevel>
                                <bundle>
                                    <id>slf4j.api</id>
                                    <level>1</level>
                                    <autoStart>true</autoStart>
                                </bundle>
                                <bundle>
                                    <id>org.apache.logging.log4j.api</id>
                                    <level>2</level>
                                    <autoStart>true</autoStart>
                                </bundle>
                                <bundle>
                                    <id>org.apache.logging.log4j.core</id>
                                    <level>2</level>
                                    <autoStart>true</autoStart>
                                </bundle>
                                <bundle>
                                    <id>org.apache.logging.log4j.slf4j2.impl</id>
                                    <level>2</level>
                                    <autoStart>true</autoStart>
                                </bundle>
                                <bundle>
                                    <id>j2db_log4j</id>
                                    <level>3</level>
                                    <autoStart>true</autoStart>
                                </bundle>
                            </bundleStartLevel>
                            <dependencies>
                                <dependency>
                                    <type>eclipse-plugin</type>
                                    <artifactId>com.servoy.eclipse.extension.compatibility</artifactId>
                                </dependency>
                                <dependency>
                                    <type>eclipse-plugin</type>
                                    <artifactId>com.servoy.eclipse.cypress</artifactId>
                                </dependency>
                                <dependency>
                                    <type>eclipse-plugin</type>
                                    <artifactId>j2db_log4j</artifactId>
                                </dependency>
                                <dependency>
                                    <type>eclipse-plugin</type>
                                    <artifactId>org.apache.logging.log4j.core</artifactId>
                                </dependency>
                                <dependency>
                                    <type>eclipse-plugin</type>
                                    <artifactId>org.apache.logging.log4j.api</artifactId>
                                </dependency>
                                <dependency>
                                    <type>eclipse-plugin</type>
                                    <artifactId>org.apache.logging.log4j.slf4j2.impl</artifactId>
                                </dependency>
                                <dependency>
                                    <type>eclipse-plugin</type>
                                    <artifactId>slf4j.api</artifactId>
                                </dependency>
                                 <dependency>
                                    <type>eclipse-plugin</type>
                                    <artifactId>${arch.extension.plugin}</artifactId>
                                </dependency>
                            </dependencies>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
