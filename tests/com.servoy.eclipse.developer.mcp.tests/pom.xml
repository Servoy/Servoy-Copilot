<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <prerequisites>
        <maven>3.9.0</maven>
    </prerequisites>
    <parent>
        <groupId>com.servoy</groupId>
        <artifactId>com.servoy.eclipse.servoypilot.parent</artifactId>
        <version>2026.3.1-SNAPSHOT</version>
        <relativePath>../..</relativePath>
    </parent>
    <artifactId>com.servoy.eclipse.developer.mcp.tests</artifactId>
    <packaging>eclipse-test-plugin</packaging>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jarsigner-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>tycho-surefire-plugin</artifactId>
                <version>${tycho-version}</version>
                <configuration>
                    <useUIHarness>false</useUIHarness>
                    <application>
                        org.eclipse.pde.junit.runtime.coretestapplication</application>
                    <testClass>
                        com.servoy.eclipse.developer.mcp.AllDeveloperMcpTests</testClass>
                    <argLine>
                        -Xms128m -Xmx512m -ea
                        --add-exports=java.base/sun.security.x509=ALL-UNNAMED
                        -Dorg.osgi.framework.system.packages.extra=sun.security.x509</argLine>
                    <dependencies>
                        <dependency>
                            <type>eclipse-plugin</type>
                            <artifactId>
                                com.servoy.eclipse.extension.compatibility</artifactId>
                        </dependency>
                    </dependencies>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>win32-x86_64</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <arch.extension.plugin>com.servoy.eclipse.nodejs.win32.win32.x86_64</arch.extension.plugin>
            </properties>
        </profile>
        <profile>
            <id>win32-aarch64</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <arch.extension.plugin>com.servoy.eclipse.nodejs.win32.win32.aarch64</arch.extension.plugin>
            </properties>
        </profile>
        <profile>
            <id>linux-x86_64</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <arch.extension.plugin>com.servoy.eclipse.nodejs.linux.gtk.x86_64</arch.extension.plugin>
            </properties>
        </profile>
        <profile>
            <id>mac-aarch64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <arch.extension.plugin>com.servoy.eclipse.nodejs.macosx.aarch64</arch.extension.plugin>
            </properties>
        </profile>
        <profile>
            <id>integration</id>
            <properties>
                <servoy_install>${project.basedir}/testresources/servoy_lts_extracted</servoy_install>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>prepare-servoy-install</id>
                                <phase>generate-test-resources</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target xmlns:if="ant:if" xmlns:unless="ant:unless">
                                        <property name="tarball" value="${servoy.install.tarball.for.appserver}"/>
                                        <property name="extract_dir" value="${project.basedir}/testresources/servoy_lts_extracted"/>
                                        <property name="timestamp_file" value="${project.basedir}/testresources/servoy_lts_extracted.timestamp"/>

                                        <!-- Only act if the tarball exists (i.e. we are on Jenkins) -->
                                        <available file="${tarball}" property="tarball_exists"/>

                                        <!-- Check if the timestamp file is at least as new as the tarball -->
                                        <uptodate property="extraction_current"
                                            srcfile="${tarball}" targetfile="${timestamp_file}"
                                            if:set="tarball_exists"/>

                                        <!-- If tarball exists but extraction is stale/missing: re-extract -->
                                        <sequential if:set="tarball_exists" unless:set="extraction_current">
                                            <delete dir="${extract_dir}" quiet="true"/>
                                            <delete file="${timestamp_file}" quiet="true"/>
                                            <mkdir dir="${extract_dir}"/>
                                            <untar src="${tarball}" dest="${extract_dir}" compression="gzip">
                                                <patternset>
                                                    <include name="application_server/**"/>
                                                    <exclude name="application_server/postgres_db/**"/>
                                                </patternset>
                                            </untar>
                                            <!-- Stamp timestamp_file with tarball's own mtime -->
                                            <exec executable="touch">
                                                <arg value="-r"/>
                                                <arg value="${tarball}"/>
                                                <arg value="${timestamp_file}"/>
                                            </exec>
                                        </sequential>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.eclipse.tycho</groupId>
                        <artifactId>tycho-surefire-plugin</artifactId>
                        <version>${tycho-version}</version>
                        <configuration>
                            <testClass>
                                com.servoy.eclipse.developer.mcp.AllDeveloperMcpIntegrationTests</testClass>
                            <useUIHarness>true</useUIHarness>
                            <useUIThread>false</useUIThread>
                            <product>com.servoy.eclipse.core.ide</product>
                            <application>org.eclipse.ui.ide.workbench</application>
                            <argLine>-Xms256m -Xmx2048m -ea
                                --add-exports=java.base/sun.security.x509=ALL-UNNAMED
                                -Dorg.osgi.framework.system.packages.extra=sun.security.x509
                                -Dservoy.cloud.skipCheckout=true
                                -Dservoy.application_server.dir=${servoy_install}/application_server
                                -Dproperty-file=${project.basedir}/testresources/servoy.properties
                                -Dchromium.integration.eclipse.disable=true
                                -Dorg.eclipse.ui.testing=true</argLine>
                            <deleteOsgiDataDirectory>false</deleteOsgiDataDirectory>
                            <bundleStartLevel>
                                <bundle>
                                    <id>slf4j.api</id>
                                    <level>1</level>
                                    <autoStart>true</autoStart>
                                </bundle>
                                <bundle>
                                    <id>org.apache.logging.log4j.api</id>
                                    <level>2</level>
                                    <autoStart>true</autoStart>
                                </bundle>
                                <bundle>
                                    <id>org.apache.logging.log4j.core</id>
                                    <level>2</level>
                                    <autoStart>true</autoStart>
                                </bundle>
                                <bundle>
                                    <id>org.apache.logging.log4j.slf4j2.impl</id>
                                    <level>2</level>
                                    <autoStart>true</autoStart>
                                </bundle>
                                <bundle>
                                    <id>j2db_log4j</id>
                                    <level>3</level>
                                    <autoStart>true</autoStart>
                                </bundle>
                            </bundleStartLevel>
                            <dependencies>
                                <dependency>
                                    <type>eclipse-plugin</type>
                                    <artifactId>com.servoy.eclipse.extension.compatibility</artifactId>
                                </dependency>
                                <dependency>
                                    <type>eclipse-plugin</type>
                                    <artifactId>com.servoy.eclipse.cypress</artifactId>
                                </dependency>
                                <dependency>
                                    <type>eclipse-plugin</type>
                                    <artifactId>j2db_log4j</artifactId>
                                </dependency>
                                <dependency>
                                    <type>eclipse-plugin</type>
                                    <artifactId>org.apache.logging.log4j.core</artifactId>
                                </dependency>
                                <dependency>
                                    <type>eclipse-plugin</type>
                                    <artifactId>org.apache.logging.log4j.api</artifactId>
                                </dependency>
                                <dependency>
                                    <type>eclipse-plugin</type>
                                    <artifactId>org.apache.logging.log4j.slf4j2.impl</artifactId>
                                </dependency>
                                <dependency>
                                    <type>eclipse-plugin</type>
                                    <artifactId>slf4j.api</artifactId>
                                </dependency>
                                 <dependency>
                                    <type>eclipse-plugin</type>
                                    <artifactId>${arch.extension.plugin}</artifactId>
                                </dependency>
                            </dependencies>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
