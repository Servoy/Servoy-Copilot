<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<prerequisites>
		<maven>3.9.0</maven>
	</prerequisites>
	<parent>
		<groupId>com.servoy</groupId>
		<artifactId>com.servoy.eclipse.servoypilot.parent</artifactId>
		<version>2026.3.1-SNAPSHOT</version>
		<relativePath>../..</relativePath>
	</parent>
	<artifactId>com.servoy.eclipse.opencode.tests</artifactId>
	<packaging>eclipse-test-plugin</packaging>
	<build>
		<plugins>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-surefire-plugin</artifactId>
				<version>${tycho-version}</version>
				<configuration>
                    <!-- Force the JUnit Platform (junit6) provider. The Eclipse target platform
                         always contributes org.junit (JUnit 4) to the test runtime, so Tycho's
                         automatic framework detection would otherwise pick the junit4 provider
                         and report "No tests found" for these pure-Jupiter tests. -->
                    <providerHint>junit6</providerHint>
					<useUIHarness>false</useUIHarness>
					<application>
						org.eclipse.pde.junit.runtime.coretestapplication</application>
					<includes>
						<include>**/plainjunit/**/*Test.java</include>
					</includes>
					<argLine>-Xms128m -Xmx512m -ea --add-exports=java.base/sun.security.x509=ALL-UNNAMED -Dorg.osgi.framework.system.packages.extra=sun.security.x509</argLine>
					<dependencies>
						<dependency>
							<type>eclipse-plugin</type>
							<artifactId>
								com.servoy.eclipse.extension.compatibility</artifactId>
						</dependency>
					</dependencies>
				</configuration>
			</plugin>
		</plugins>
	</build>
	<profiles>
		<profile>
			<id>integration</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.eclipse.tycho</groupId>
						<artifactId>tycho-surefire-plugin</artifactId>
						<version>${tycho-version}</version>
						<configuration>
		                    <!-- Force the JUnit Platform (junit6) provider. The Eclipse target platform
		                         always contributes org.junit (JUnit 4) to the test runtime, so Tycho's
		                         automatic framework detection would otherwise pick the junit4 provider
		                         and report "No tests found" for these pure-Jupiter tests. -->
		                    <providerHint>junit6</providerHint>
							<includes>
								<include>**/integrationpde/**/*Test.java</include>
							</includes>
							<useUIHarness>true</useUIHarness>
							<useUIThread>false</useUIThread>
							<product>com.servoy.eclipse.core.ide</product>
							<application>org.eclipse.ui.ide.workbench</application>
							<argLine>-Xms256m -Xmx2048m -ea --add-exports=java.base/sun.security.x509=ALL-UNNAMED -Dorg.osgi.framework.system.packages.extra=sun.security.x509 -Dservoy.cloud.skipCheckout=true -Dchromium.integration.eclipse.disable=true -Dorg.eclipse.ui.testing=true</argLine>
							<deleteOsgiDataDirectory>false</deleteOsgiDataDirectory>
							<dependencies>
								<dependency>
									<type>eclipse-plugin</type>
									<artifactId>com.servoy.eclipse.extension.compatibility</artifactId>
								</dependency>
							</dependencies>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
