<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.servoy</groupId>
        <artifactId>com.servoy.eclipse.servoypilot.parent</artifactId>
        <version>2026.3.0-SNAPSHOT</version>
        <relativePath>../..</relativePath>
    </parent>
    <artifactId>com.servoy.eclipse.servoypilot.assistenttests</artifactId>
    <!-- eclipse-test-plugin: Tycho treats this as a PDE test bundle.
         Default build: Layer 1 unit tests only (headless, fast).
         With -Pintegration: all tests including Layer 2/3/4 (requires UI harness + Xvfb on Linux). -->
    <packaging>eclipse-test-plugin</packaging>
    <build>
        <plugins>
            <!-- Skip JAR signing for the test bundle — it is never deployed or published. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jarsigner-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>tycho-surefire-plugin</artifactId>
                <version>${tycho-version}</version>
                <configuration>
                    <includes>
                        <include>**/unit/*Test.java</include>
                    </includes>
                    <useUIHarness>true</useUIHarness>
                    <useUIThread>true</useUIThread>
                    <application>org.eclipse.ui.ide.workbench</application>
                    <dependencies>
                        <dependency>
                            <type>eclipse-plugin</type>
                            <artifactId>com.servoy.eclipse.extension.compatibility</artifactId>
                        </dependency>
                    </dependencies>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <!-- Runs ALL tests (unit + integration) inside a full Eclipse workbench.
                 The Servoy plugins activate automatically, starting the embedded app server.
                 On Linux CI agents, Xvfb must be available for the Display.
                 Usage: mvn verify -Pintegration -->
            <id>integration</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.eclipse.tycho</groupId>
                        <artifactId>tycho-surefire-plugin</artifactId>
                        <version>${tycho-version}</version>
                        <configuration>
                            <includes>
                                <include>**/integration/*Test.java</include>
                            </includes>
                            <excludes/>
                            <useUIHarness>true</useUIHarness>
                            <useUIThread>true</useUIThread>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
