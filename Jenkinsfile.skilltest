// RUN job for the Servoy AI skill-test suite (SVY-21366).
//
// Runs the real skill-test SCENARIOS from the servoy-ai-skilltest-baselines repo
// against the real LLM. The scenarios need a running Servoy workbench (they create
// solutions over MCP, check the live model, and run JSUnit in a SmartClient), so
// they are launched via a tycho-surefire PDE run of the skilltest.tests project's
// 'integration' profile: Tycho boots a FULLY RESOLVED workbench from the target
// platform + reactor (so the IDE bundles resolve - unlike extracting the shipped
// tarball product), and only application_server is taken from the tarball. The
// SkillTestCiRunnerTest ignition then invokes the real SkillTestHeadlessRunner over
// the cloned baselines.

// Minimal HTML escaping for the trend-alert email body (SVY-21661).
def htmlEsc(Object value) {
    if (value == null) {
        return ''
    }
    return value.toString().replace('&', '&amp;').replace('<', '&lt;').replace('>', '&gt;').replace('"', '&quot;')
}

pipeline {
    agent any

    options {
        timeout(time: 90, unit: 'MINUTES')
        timestamps()
        // SVY-21661: single writer of the persistent run history on the agent
        // ($JENKINS_HOME/skilltest-history/run-history.jsonl).
        disableConcurrentBuilds()
    }

    parameters {
        // SVY-21661: recipients of the trend-alert email - a comma-separated list, so more
        // people can be added here (or on the job's parameter) without a code change.
        // Empty = no email (the build is still marked UNSTABLE on trend alerts).
        string(name: 'SKILLTEST_ALERT_EMAIL', defaultValue: 'emera@servoy.com',
               description: 'Comma-separated recipients of the skill-test trend-alert email (empty = no email)')
        // SVY-21661: trial period - trend alerts do NOT post to Teams until they are tested.
        // Set to true to also send the Teams "Unstable" card for trend-alert-only builds.
        booleanParam(name: 'SKILLTEST_ALERT_TEAMS', defaultValue: false,
                     description: 'Also notify Teams when the build is UNSTABLE only because of trend alerts')
    }

    triggers {
        // Run at most once per day, at 03:00, and ONLY when the AI-plugin code
        // changed. pollSCM checks the repo at 03:00; if there are no new commits
        // it does NOT start a build at all (no success/failure record), unlike a
        // plain cron which would fire every day. The path filtering is done by the
        // GitSCM `includedRegions` on the SCM checkout below (Checkout stage), so a
        // commit that touches only docs/poms/other bundles is ignored by polling and
        // never starts a build. The three gated paths are the AI bundles:
        // com.servoy.eclipse.developer.mcp, com.servoy.eclipse.opencode and
        // com.servoy.eclipse.opencode.skilltest (SVY-21366).
        pollSCM('H 3 * * *')
    }

    environment {
        TEAMS_WEBHOOK = credentials('servoy-teams-webhook')
        // The reactor build runs the full Tycho lifecycle incl.
        // tycho-gpg-plugin:sign-p2-artifacts, which needs the signing key passphrase -
        // same as the main build Jenkinsfile.
        MAVEN_GPG_PASSPHRASE = credentials('servoy-gpg-passphrase')
    }

    tools {
        jdk 'Java 21'
        maven 'Maven 3.9.16'
    }

    stages {
        stage('Checkout') {
            steps {
                // Path-filtered checkout: `includedRegions` makes pollSCM ignore commits
                // that touch ONLY paths outside the three AI bundles, so polling starts a
                // build exclusively for in-path changes and leaves no build record for
                // off-path commits (SVY-21366). The regions are the SCM-relative paths of
                // the gated bundles. Everything else (branch, credentials, URL) is taken
                // from the job's own SCM config via `scm`, extended with the include filter.
                checkout([$class: 'GitSCM',
                    branches: scm.branches,
                    userRemoteConfigs: scm.userRemoteConfigs,
                    extensions: scm.extensions + [[$class: 'PathRestriction',
                        includedRegions: '''bundles/com.servoy.eclipse.developer.mcp/.*
bundles/com.servoy.eclipse.opencode/.*
bundles/com.servoy.eclipse.opencode.skilltest/.*''',
                        excludedRegions: '']]])
            }
        }

        stage('Checkout baselines') {
            // No per-stage gate: the daily poll (pollSCM + includedRegions, see triggers)
            // only STARTS a build when one of the three AI bundles changed, and a manual
            // "Build Now" is an explicit on-demand run. In both cases the scenarios should
            // run, so the stage runs unconditionally once the build has started. (The old
            // changeset gates were needed only because githubPush fired on every push,
            // including off-path/deploy-only commits; path-filtered polling removes that.)
            steps {
                // The baseline scenarios are curated by testers in a SEPARATE private repo
                // (Servoy/servoy-ai-skilltest-baselines) they have access to, independent of
                // this plugin source. Check it out (shallow; refreshed on re-runs) into a
                // sub-directory of the job workspace. The run points -Dservoy.skilltest.baselines
                // straight at ${WORKSPACE}/baselines-repo/baselines - no copy step.
                dir('baselines-repo') {
                    checkout([$class: 'GitSCM',
                        branches: [[name: '*/master']],
                        extensions: [[$class: 'CloneOption', shallow: true, depth: 1]],
                        userRemoteConfigs: [[
                            url: 'https://github.com/Servoy/servoy-ai-skilltest-baselines.git',
                            credentialsId: 'servoy-github-app']]])
                }
            }
        }

        stage('Checkout + zip skills (skill4servoy)') {
            // Runs unconditionally once the build has started - see 'Checkout baselines'.
            // Path-filtered polling (triggers) already ensures the build only starts for an
            // in-path AI-bundle change or a manual run.
            steps {
                // The Kiro path needs the SERVOY (not public/sample) skills: skill4servoy's
                // .opencode-shippable, zipped so SkillsZipExtractor extracts it into
                // ~/.servoy/opencode/. opencode_servoy.json is the kiro provider config
                // (model kiro/auto + @servoy/opencode-kiro-auth); it must land in the zip
                // ROOT as opencode.json so extractToConfigDir writes it as the active config
                // (and sets providerFromZip=true, so no litellm/GENAI provider is written).
                dir('skill4servoy') {
                    checkout([$class: 'GitSCM',
                        branches: [[name: '*/master']],
                        extensions: [[$class: 'CloneOption', shallow: true, depth: 1]],
                        userRemoteConfigs: [[
                            url: 'https://github.com/Servoy/skill4servoy.git',
                            credentialsId: 'servoy-github-app']]])
                }
                sh '''
                    rm -f "$WORKSPACE/skilltest-skills.zip"
                    cp "$WORKSPACE/skill4servoy/opencode_servoy.json" "$WORKSPACE/skill4servoy/.opencode-shippable/opencode.json"
                    # Use the JDK's jar (always present via the Java tool) rather than `zip`,
                    # which is not installed on the CI agent. -C zips entries relative to
                    # .opencode-shippable so opencode.json / skills/ land at the zip root.
                    rm -rf "$WORKSPACE/skill4servoy/.opencode-shippable/.opencode"
                    jar -cf "$WORKSPACE/skilltest-skills.zip" -C "$WORKSPACE/skill4servoy/.opencode-shippable" .
                '''
            }
        }

        stage('Run skill-test scenarios') {
            // Runs unconditionally once the build has started - see 'Checkout baselines'.
            // Path-filtered polling (triggers) already ensures the build only starts for an
            // in-path AI-bundle change or a manual run.
            steps {
                // KIRO_API_KEY is bound as an ENV VAR (not -D): the @servoy/opencode-kiro-auth
                // plugin in the opencode child process reads it from the environment, which the
                // surefire fork + opencode child inherit from this shell. GENAI_API_KEY only has to
                // be non-blank (opencode setup gate, MCP entitlement, CloudLogin skip), so the mvn
                // line passes a fixed placeholder. Real auth is KIRO_API_KEY.
                // GIT_TOKEN: the git-source baselines clone a PRIVATE repo (Servoy/servoy_test)
                // over HTTPS via jgit. Headless, jgit must not fall back to EGit's UI credentials
                // provider (it calls a null workbench UI service -> "A null service reference is
                // not allowed", SVY-21366). SolutionSetup reads GIT_TOKEN and uses a
                // UsernamePasswordCredentialsProvider instead. Reuse the same GitHub App
                // credential the checkouts use; its password/token is the clone token.
                withCredentials([
                        string(credentialsId: 'servoy-kiro-api-key', variable: 'KIRO_API_KEY'),
                        usernamePassword(credentialsId: 'servoy-github-app',
                        usernameVariable: 'GIT_USER', passwordVariable: 'GIT_TOKEN')]) {
                    wrap([$class: 'Xvfb', installationName: 'xvfb', autoDisplayName: true]) {
                      // Quiet the headless GTK/SWT noise that otherwise floods the console:
                      // SWT drives GTK off-screen under Xvfb, and GTK emits benign
                      // 'Gtk-CRITICAL ... gtk_box_gadget_distribute: assertion size >= 0'
                      // (and a11y/at-spi) messages to stderr for zero-size offscreen widgets.
                      // These are cosmetic, not test failures. NO_AT_BRIDGE=1 drops the
                      // accessibility-bus warnings; G_MESSAGES_DEBUG= (empty) enables no GLib
                      // debug domains; GTK_MODULES= clears any auto-loaded a11y module.
                      //
                      // The scrollbar message above is a GTK *core* CRITICAL, not an a11y/at-spi
                      // warning, so none of those env vars can drop it (there is no env switch to
                      // silence an individual GLib CRITICAL). So on top of the env-only approach we
                      // filter the mvn STDERR through a grep -v that strips only the known-benign
                      // GTK/at-spi lines, while leaving STDOUT (the real build/test output)
                      // completely untouched and preserving mvn's real exit code. (SVY-21366)
                      withEnv(['NO_AT_BRIDGE=1', 'G_MESSAGES_DEBUG=', 'GTK_MODULES=']) {
                        configFileProvider([
                            configFile(fileId: 'ba7b9372-76e5-4898-a2be-1dde60a0d6e3', variable: 'MAVEN_SETTINGS'),
                            configFile(fileId: 'maven_toolchain', variable: 'TOOLCHAIN')
                        ]) {
                            // One invocation. -Pintegration builds the 3 AI bundles from source,
                            // extracts only application_server/** from the tarball, and runs
                            // SkillTestCiRunnerTest under a tycho-surefire workbench (resolved from
                            // the target platform). That ignition calls the real
                            // SkillTestHeadlessRunner over the cloned baselines and writes
                            // TEST-skilltest.xml. -Dservoy.skilltest.run=true un-skips the ignition.
                            // The 3 AI bundle modules are listed explicitly (not -am): the test
                            // plugin is a FRAGMENT of com.servoy.eclipse.opencode.skilltest, an OSGi
                            // (not Maven) dependency, so -am would not pull the host bundle into the
                            // reactor and Tycho could not resolve it at the reactor qualifier.
                            // kiroApiKey -> -DGENAI_API_KEY (gate only, a non-secret placeholder); the
                            // real Kiro auth uses the KIRO_API_KEY env var bound above. skillsZip is the skill4servoy
                            // .opencode-shippable bundle zipped in the previous stage.
                            // Run under bash so the stderr process-substitution filter below
                            // works. mvn's stderr is routed through a grep -v that drops ONLY the
                            // known-benign headless GTK/at-spi lines back to stderr; stdout (the
                            // real build/test output) is left completely untouched. Because the
                            // filter is a process substitution on fd 2 - not a `mvn | grep`
                            // pipeline - the shell's exit status is mvn's own, so a real
                            // build/test failure still fails the stage regardless of what grep
                            // matched (set -o pipefail is kept for any future piping).
                            // catchError: a failing/erroring scenario run marks the BUILD unstable and this
                            // STAGE failed, but must not skip 'Deploy skilltest p2 site' (build 94: a hung
                            // scenario skipped the deploy, so colleagues could not install). The p2 site
                            // is built from the bundles, not from the test results.
                            catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                            sh '''#!/bin/bash
                                set -o pipefail
                                # Start from an EMPTY report dir. skilltest-reports lives in
                                # $WORKSPACE, outside target/, so `mvn clean` never wipes it and the
                                # CI workspace is not cleaned between builds. If a run dies before
                                # SkillTestHeadlessRunner writes its report (hang -> Maven timeout,
                                # infra failure), the PREVIOUS build's TEST-skilltest.xml would still
                                # be there and the junit step below would publish it as this build's
                                # result - stale verdicts and metrics that contradict this build's
                                # console. With the dir emptied, a run that wrote no report publishes
                                # nothing from here and allowEmptyResults:false surfaces it.
                                rm -rf "$WORKSPACE/skilltest-reports"
                                mkdir -p "$WORKSPACE/skilltest-reports"
                                # Fresh kiro-auth plugin state (kiro.json, kiro.db, kiro-usage.json,
                                # kiro-plugin.log) every build. The plugin registers KIRO_API_KEY only
                                # when kiro.db holds no API-key account yet, so a state dir that
                                # survives builds (the old ~/.servoy/opencode default) kept using an
                                # old or revoked key after a rotation. The opencode child inherits
                                # KIRO_CONFIG_DIR from this shell; KiroCreditReader reads it too.
                                export KIRO_CONFIG_DIR="$WORKSPACE/kiro-state"
                                rm -rf "$KIRO_CONFIG_DIR"
                                mkdir -p "$KIRO_CONFIG_DIR"
                                # Run history (SVY-21661): an append-only run-history.jsonl in a FIXED,
                                # persistent directory owned by the Jenkins user, so it accumulates across
                                # nightly builds: $JENKINS_HOME/skilltest-history (not public, survives
                                # builds and workspace wipes). It is deliberately NOT under
                                # $WORKSPACE/skilltest-reports (emptied above at the start of every build,
                                # b79c5b2), target/ (mvn clean) or kiro-state/ (deleted after the run), and
                                # not under /data (the jenkins user may not create dirs there - build #92).
                                # Copy Artifact chaining and committing it to the baselines repo were
                                # rejected on this case. If the dir is not writable the runner logs it and
                                # the run still succeeds. The runner also copies the file into
                                # skilltest-reports/ so each build archives a snapshot.
                                SKILLTEST_HISTORY_DIR="${JENKINS_HOME:-/var/lib/jenkins}/skilltest-history"
                                mkdir -p "$SKILLTEST_HISTORY_DIR"
                                SKILLS_VERSION="$(git -C "$WORKSPACE/skill4servoy" rev-parse --short HEAD 2>/dev/null || true)"
                                # Tee the whole run to opencode-server.log so the opencode child
                                # process output (model-call results, auth/quota errors, the reason
                                # an agent run produced nothing) is captured on disk and archived -
                                # the Jenkins console scrolls and is not kept per-build, and this
                                # output is the only place the provider/model failure is visible.
                                mvn -B -s "$MAVEN_SETTINGS" -t "$TOOLCHAIN" \
                                clean verify \
                                -Pintegration \
                                -pl bundles/com.servoy.eclipse.opencode,bundles/com.servoy.eclipse.developer.mcp,bundles/com.servoy.eclipse.opencode.skilltest,tests/com.servoy.eclipse.opencode.skilltest.tests \
                                -Dtycho.localArtifacts=ignore \
                                -Dservoy.url=file:///data/www/latest/servoy_lts_2026/update_site/ \
                                -Dservoy.install.tarball.for.appserver=/data/www/latest/servoy_lts_2026/servoy_linux.tar.gz \
                                -Dservoy.skilltest.run=true \
                                -Dservoy.skilltest.baselines="$WORKSPACE/baselines-repo/baselines" \
                                -Dservoy.skilltest.outputDir="$WORKSPACE/skilltest-reports" \
                                -Dservoy.skilltest.kiroApiKey="ci-skilltest-no-genai" \
                                -Dservoy.skilltest.skillsZip="$WORKSPACE/skilltest-skills.zip" \
                                -Dopencode.shutdown.debug=true \
                                -Dservoy.skilltest.historyFile="$SKILLTEST_HISTORY_DIR/run-history.jsonl" \
                                -Dservoy.skilltest.skillsVersion="$SKILLS_VERSION" \
                                2> >(grep -v -E 'Gtk-CRITICAL|Gtk-WARNING|gtk_box_gadget_distribute|assertion .size >= 0.|at-spi|AT-SPI|atk-bridge|Couldn.t (register|connect) with accessibility bus' >&2) \
                                | sed -u "s|${KIRO_API_KEY}|****|g" \
                                | tee "$WORKSPACE/skilltest-reports/opencode-server.log"
                                rc=$?
                                # Backstop: the key no longer goes on the fork command line (GENAI_API_KEY
                                # gets a fixed placeholder above), but Jenkins only masks its own console,
                                # not files. Mask anything that still slips into the tee'd log (pipe above)
                                # or the tycho-surefire XML <properties> the junit step publishes, while
                                # KIRO_API_KEY is still bound. Key is [A-Za-z0-9_].
                                find "$WORKSPACE" -path '*/target/surefire-reports/*' -name '*.xml' \
                                    -exec sed -i "s|${KIRO_API_KEY}|****|g" {} +
                                exit $rc'''
                            }
                        }
                      }
                    }
                }
            }
            post {
                always {
                    // The runner writes TEST-skilltest.xml to -Dservoy.skilltest.outputDir;
                    // tycho-surefire also writes its own surefire reports. allowEmptyResults:false
                    // so a run that produced NO report (e.g. the workbench never came up) fails the
                    // build instead of a silent SUCCESS.
                    // Capture the workbench's own log + opencode output BEFORE the next
                    // `clean` wipes target/. The opencode setup (OpencodeFolderCreatorJob,
                    // RunOpencodeCommand, kiro-auth) logs via ServoyLog to the Eclipse
                    // .metadata/.log, which the Jenkins console does NOT show - this is where
                    // "opencode server did not become ready" has its real cause.
                    //
                    // Copy the DOT-named logs to non-dot names first: Jenkins archiveArtifacts
                    // applies Ant "default excludes" which skip .* paths (.metadata, .log), so a
                    // direct glob of **/.metadata/.log silently matches nothing. We copy to
                    // plain names under $WORKSPACE/skilltest-logs and archive THAT.
                    sh '''
                        set +e
                        mkdir -p "$WORKSPACE/skilltest-logs"
                        # Only the Eclipse workbench log (.metadata/.log) is useful; the per-plugin
                        # *.log files under target/work (npm/turbo/karma/browser) are build noise and
                        # are deliberately NOT collected. Copy the dot-named .log to a plain name so
                        # Jenkins' Ant default-excludes (which skip .* paths) still archive it.
                        find "$WORKSPACE" -path '*/target/work/data/.metadata/.log' -exec cp {} "$WORKSPACE/skilltest-logs/workbench.log" \\; 2>/dev/null
                        # The opencode server's stdout/stderr streams through the Maven run, which
                        # is tee'd to skilltest-reports/opencode-server.log by the run step above;
                        # that file carries the model-call result and is archived below.
                        # Delete the per-build kiro-auth state dir: kiro.db / kiro.json hold the
                        # Kiro key and must not stay browsable in the workspace. Nothing from it is
                        # copied or archived.
                        rm -rf "$WORKSPACE/kiro-state"
                        echo "collected logs:"; ls -la "$WORKSPACE/skilltest-logs" 2>/dev/null
                    '''
                    // The coverage report is written to the FIXED name coverage.html (one per
                    // build, overwritten each run - SVY-21711), not the old coverage-<timestamp>.html.
                    // Match that exact name; the stale timestamped files are cleaned below so they
                    // stop accumulating in the (un-cleaned) workspace and the artifacts.
                    sh 'rm -f "$WORKSPACE/skilltest-reports/coverage-"*.html 2>/dev/null || true'
                    // SVY-21661: also archive the run-history snapshot, the trend report + its
                    // stylesheet (skilltest-report.css must sit next to trend.html/coverage.html
                    // so their relative <link> resolves) and alerts.json.
                    archiveArtifacts artifacts: 'skilltest-logs/workbench.log, skilltest-reports/TEST-skilltest.xml, skilltest-reports/coverage.html, skilltest-reports/opencode-server.log, skilltest-reports/run-history.jsonl, skilltest-reports/trend.html, skilltest-reports/skilltest-report.css, skilltest-reports/alerts.json',
                                     allowEmptyArchive: true, fingerprint: false
                    script {
                        def junitSummary = junit allowEmptyResults: false,
                              testResults: 'skilltest-reports/TEST-*.xml, **/target/surefire-reports/TEST-*.xml'
                        env.SKILLTEST_JUNIT_FAILURES = "${junitSummary?.failCount ?: 0}"
                    }
                    // SVY-21661: the trend report is NOT published under /data/www (that is served
                    // publicly at build.servoy.com/latest/). Like coverage.html it is only a build
                    // artifact behind the Jenkins login, listed under the job's "Last Successful
                    // Artifacts"; the stable link is
                    // <job>/lastSuccessfulBuild/artifact/skilltest-reports/trend.html.
                    // SVY-21661: trend alerts. alerts.json is always written by the runner (count 0
                    // when clean); if it is missing the runner crashed before writing it, and the
                    // junit/failure handling above already covers that, so nothing alert-related
                    // happens. count > 0 -> UNSTABLE + an alert email (no Teams post during the
                    // trial, see the global post { unstable } guard).
                    script {
                        def alertsFile = 'skilltest-reports/alerts.json'
                        if (fileExists(alertsFile)) {
                            int count = 0
                            def alertList = []
                            try {
                                def json = readJSON file: alertsFile
                                count = (json.count ?: 0) as int
                                alertList = json.alerts ?: []
                            } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException e) {
                                throw e
                            } catch (Exception | NoSuchMethodError readJsonUnavailable) {
                                // Pipeline Utility Steps not installed: fall back to the count only.
                                def raw = sh(returnStdout: true,
                                        script: "grep -o '\"count\" *: *[0-9]*' '${alertsFile}' | grep -o '[0-9]*\$' || echo 0").trim()
                                count = raw.isInteger() ? raw.toInteger() : 0
                            }
                            if (count > 0) {
                                env.SKILLTEST_TREND_ALERTS = 'true'
                                unstable("Skill-test trend alerts: ${count}")
                                if ((env.SKILLTEST_JUNIT_FAILURES ?: '0') == '0') {
                                    // Marker read by the global post { fixed } Teams guard on the next build;
                                    // must not be overwritten later in this build.
                                    currentBuild.description = "trend-alerts-only (${count})"
                                }
                                String recipients = (params.SKILLTEST_ALERT_EMAIL ?: '').trim()
                                if (recipients) {
                                    // Jenkins-internal (login required), never the public /latest/ site.
                                    String reportUrl = "${env.JOB_URL}lastSuccessfulBuild/artifact/skilltest-reports/trend.html"
                                    String artifactUrl = "${env.BUILD_URL}artifact/skilltest-reports/trend.html"
                                    String subject = "[skilltest] ${count} trend alert(s) - build #${env.BUILD_NUMBER}"
                                    StringBuilder html = new StringBuilder()
                                    html.append('<p>').append(count).append(' skill-test trend alert(s) in build #')
                                        .append(htmlEsc(env.BUILD_NUMBER)).append('.</p>')
                                    StringBuilder text = new StringBuilder()
                                    text.append(count).append(' skill-test trend alert(s) in build #').append(env.BUILD_NUMBER).append('\n\n')
                                    if (alertList) {
                                        html.append('<table border="1" cellpadding="4" cellspacing="0"><tr><th>Baseline</th><th>Rule</th><th>Message</th><th>Likely cause</th></tr>')
                                        for (def a : alertList) {
                                            html.append('<tr><td>').append(htmlEsc(a.baselineId)).append('</td><td>')
                                                .append(htmlEsc(a.rule)).append('</td><td>').append(htmlEsc(a.message))
                                                .append('</td><td>').append(htmlEsc(a.likelyCause)).append('</td></tr>')
                                            text.append("- ${a.baselineId} ${a.rule}: ${a.message}")
                                            if (a.likelyCause) {
                                                text.append(" (likely cause: ${a.likelyCause})")
                                            }
                                            text.append('\n')
                                        }
                                        html.append('</table>')
                                    } else {
                                        html.append('<p>See alerts.json in the build artifacts for the details.</p>')
                                        text.append('See alerts.json in the build artifacts for the details.\n')
                                    }
                                    html.append('<p><a href="').append(htmlEsc(env.BUILD_URL)).append('">Build</a> | <a href="')
                                        .append(htmlEsc(artifactUrl)).append('">trend.html (artifact)</a> | <a href="')
                                        .append(htmlEsc(reportUrl)).append('">Latest trend report</a></p>')
                                    text.append("\nBuild: ${env.BUILD_URL}\ntrend.html: ${artifactUrl}\nLatest trend report: ${reportUrl}\n")
                                    try {
                                        emailext(to: recipients, subject: subject, body: html.toString(), mimeType: 'text/html')
                                    } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException e) {
                                        throw e
                                    } catch (Exception | NoSuchMethodError emailextUnavailable) {
                                        // Email Extension plugin not available: core mail step, plain text.
                                        try {
                                            mail(to: recipients, subject: subject, body: text.toString())
                                        } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException e) {
                                            throw e
                                        } catch (Exception | NoSuchMethodError mailFailed) {
                                            echo "Could not send the trend-alert email: ${mailFailed}"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        stage('Deploy skilltest p2 site') {
            // Deploy only runs when the build itself ran, and the build only STARTS for an
            // in-path AI-bundle change (daily poll) or a manual run - so there is no separate
            // "skip when unchanged" gate needed here: an unchanged day never starts a build,
            // so this stage never executes on a no-change day (SVY-21366).
            steps {
                // Build + publish the internal skilltest update site to
                // build.servoy.com/latest/servoy_ai_skilltest/. Separate invocation because the
                // scenario run above only builds the test project + its deps, not the site.
                configFileProvider([
                    configFile(fileId: 'ba7b9372-76e5-4898-a2be-1dde60a0d6e3', variable: 'MAVEN_SETTINGS'),
                    configFile(fileId: 'maven_toolchain', variable: 'TOOLCHAIN')
                ]) {
                    // List the feature + bundle modules explicitly: the site needs the
                    // skilltest FEATURE (an OSGi/p2 requirement), which -am does not pull in.
                    sh '''mvn -B -s "$MAVEN_SETTINGS" -t "$TOOLCHAIN" \
                        clean package \
                        -pl launch_target_aiplugin,bundles/com.servoy.eclipse.opencode,bundles/com.servoy.eclipse.developer.mcp,bundles/com.servoy.eclipse.opencode.skilltest,features/com.servoy.eclipse.opencode.skilltest.feature,repository.site_skilltest \
                        -Dtycho.localArtifacts=ignore \
                        -Dservoy.url=file:///data/www/latest/servoy_lts_2026/update_site/'''
                    sh '''
                    rm -rf /data/www/latest/servoy_ai_skilltest/
                    mkdir -p /data/www/latest/servoy_ai_skilltest/
                    for d in repository.site_skilltest/target/repository/; do
                        [ -d "$d" ] && cp -r "$d/." "/data/www/latest/servoy_ai_skilltest/"
                        break
                    done
                    '''
                }
            }
        }
    }

    post {
        failure {
            office365ConnectorSend webhookUrl: TEAMS_WEBHOOK, status: 'Failed', adaptiveCards: true
        }
        unstable {
            script {
                // SVY-21661: no Teams post when the build is UNSTABLE only because of trend
                // alerts (trial period) - i.e. the trend-alert flag is set and the junit step
                // reported no failures. SKILLTEST_ALERT_TEAMS=true re-enables it.
                boolean trendOnly = env.SKILLTEST_TREND_ALERTS == 'true' && (env.SKILLTEST_JUNIT_FAILURES ?: '0') == '0'
                if (!trendOnly || params.SKILLTEST_ALERT_TEAMS) {
                    office365ConnectorSend webhookUrl: TEAMS_WEBHOOK, status: 'Unstable', adaptiveCards: true
                }
            }
        }
        fixed {
            script {
                // SVY-21661: same trial guard as above - a build that was UNSTABLE only because
                // of trend alerts going back to SUCCESS does not post "Back to Normal" either.
                // (Best-effort: the previous build's reason is read from its UNSTABLE description.)
                def prev = currentBuild.previousBuild
                boolean prevTrendOnly = prev != null && prev.result == 'UNSTABLE' &&
                        (prev.description ?: '').contains('trend-alerts-only')
                if (!prevTrendOnly || params.SKILLTEST_ALERT_TEAMS) {
                    office365ConnectorSend webhookUrl: TEAMS_WEBHOOK, status: 'Back to Normal', adaptiveCards: true
                }
            }
        }
    }
}
