// RUN job for the Servoy AI skill-test suite (SVY-21366).
//
// Runs the real skill-test SCENARIOS from the servoy-ai-skilltest-baselines repo
// against the real LLM. The scenarios need a running Servoy workbench (they create
// solutions over MCP, check the live model, and run JSUnit in a SmartClient), so
// they are launched via a tycho-surefire PDE run of the skilltest.tests project's
// 'integration' profile: Tycho boots a FULLY RESOLVED workbench from the target
// platform + reactor (so the IDE bundles resolve - unlike extracting the shipped
// tarball product), and only application_server is taken from the tarball. The
// SkillTestCiRunnerTest ignition then invokes the real SkillTestHeadlessRunner over
// the cloned baselines.

pipeline {
    agent any

    options {
        timeout(time: 90, unit: 'MINUTES')
        timestamps()
    }

    triggers {
        githubPush()
    }

    environment {
        TEAMS_WEBHOOK = credentials('servoy-teams-webhook')
        // The reactor build runs the full Tycho lifecycle incl.
        // tycho-gpg-plugin:sign-p2-artifacts, which needs the signing key passphrase -
        // same as the main build Jenkinsfile.
        MAVEN_GPG_PASSPHRASE = credentials('servoy-gpg-passphrase')
    }

    tools {
        jdk 'Java 21'
        maven 'Maven 3.9.16'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Checkout baselines') {
            steps {
                // The baseline scenarios are curated by testers in a SEPARATE private repo
                // (Servoy/servoy-ai-skilltest-baselines) they have access to, independent of
                // this plugin source. Check it out (shallow; refreshed on re-runs) into a
                // sub-directory of the job workspace. The run points -Dservoy.skilltest.baselines
                // straight at ${WORKSPACE}/baselines-repo/baselines - no copy step.
                dir('baselines-repo') {
                    checkout([$class: 'GitSCM',
                        branches: [[name: '*/master']],
                        extensions: [[$class: 'CloneOption', shallow: true, depth: 1]],
                        userRemoteConfigs: [[
                            url: 'https://github.com/Servoy/servoy-ai-skilltest-baselines.git',
                            credentialsId: 'servoy-github-app']]])
                }
            }
        }

        stage('Run skill-test scenarios') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'servoy-cloud-svc',
                        usernameVariable: 'CLOUD_USER', passwordVariable: 'CLOUD_PASS')]) {
                    wrap([$class: 'Xvfb', installationName: 'xvfb', autoDisplayName: true]) {
                        configFileProvider([
                            configFile(fileId: 'ba7b9372-76e5-4898-a2be-1dde60a0d6e3', variable: 'MAVEN_SETTINGS'),
                            configFile(fileId: 'maven_toolchain', variable: 'TOOLCHAIN')
                        ]) {
                            // One invocation. -Pintegration + -am builds the 3 AI bundles from
                            // source, extracts only application_server/** from the tarball, and
                            // runs SkillTestCiRunnerTest under a tycho-surefire workbench (resolved
                            // from the target platform). That ignition calls the real
                            // SkillTestHeadlessRunner over the cloned baselines and writes
                            // TEST-skilltest.xml. -Dservoy.skilltest.run=true un-skips the ignition.
                            sh '''mvn -B -s "$MAVEN_SETTINGS" -t "$TOOLCHAIN" \
                                clean verify \
                                -Pintegration \
                                -pl tests/com.servoy.eclipse.opencode.skilltest.tests -am \
                                -Dtycho.localArtifacts=ignore \
                                -Dservoy.url=file:///data/www/latest/servoy_lts_2026/update_site/ \
                                -Dservoy.install.tarball.for.appserver=/data/www/latest/servoy_lts_2026/servoy_linux.tar.gz \
                                -Dservoy.skilltest.run=true \
                                -Dservoy.skilltest.baselines="$WORKSPACE/baselines-repo/baselines" \
                                -Dservoy.skilltest.outputDir="$WORKSPACE/skilltest-reports" \
                                -Dservoy.skilltest.cloudUser="$CLOUD_USER" \
                                -Dservoy.skilltest.cloudPass="$CLOUD_PASS"'''
                        }
                    }
                }
            }
            post {
                always {
                    // The runner writes TEST-skilltest.xml to -Dservoy.skilltest.outputDir;
                    // tycho-surefire also writes its own surefire reports. allowEmptyResults:false
                    // so a run that produced NO report (e.g. the workbench never came up) fails the
                    // build instead of a silent SUCCESS.
                    junit allowEmptyResults: false,
                          testResults: 'skilltest-reports/TEST-*.xml, **/target/surefire-reports/TEST-*.xml'
                }
            }
        }

        stage('Deploy skilltest p2 site') {
            steps {
                // Build + publish the internal skilltest update site to
                // build.servoy.com/latest/servoy_ai_skilltest/. Separate invocation because the
                // scenario run above only builds the test project + its deps, not the site.
                configFileProvider([
                    configFile(fileId: 'ba7b9372-76e5-4898-a2be-1dde60a0d6e3', variable: 'MAVEN_SETTINGS'),
                    configFile(fileId: 'maven_toolchain', variable: 'TOOLCHAIN')
                ]) {
                    sh '''mvn -B -s "$MAVEN_SETTINGS" -t "$TOOLCHAIN" \
                        clean package \
                        -pl repository.site_skilltest -am \
                        -Dtycho.localArtifacts=ignore \
                        -Dservoy.url=file:///data/www/latest/servoy_lts_2026/update_site/'''
                    sh '''
                    rm -rf /data/www/latest/servoy_ai_skilltest/
                    mkdir -p /data/www/latest/servoy_ai_skilltest/
                    for d in repository.site_skilltest/target/repository/; do
                        [ -d "$d" ] && cp -r "$d/." "/data/www/latest/servoy_ai_skilltest/"
                        break
                    done
                    '''
                }
            }
        }
    }

    post {
        failure {
            office365ConnectorSend webhookUrl: TEAMS_WEBHOOK, status: 'Failed', adaptiveCards: true
        }
        unstable {
            office365ConnectorSend webhookUrl: TEAMS_WEBHOOK, status: 'Unstable', adaptiveCards: true
        }
        fixed {
            office365ConnectorSend webhookUrl: TEAMS_WEBHOOK, status: 'Back to Normal', adaptiveCards: true
        }
    }
}
