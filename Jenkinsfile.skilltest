// RUN job for the Servoy AI skill-test suite (SVY-21366).
//
// Runs the real skill-test SCENARIOS from the servoy-ai-skilltest-baselines repo
// against the real LLM. The scenarios need a running Servoy workbench (they create
// solutions over MCP, check the live model, and run JSUnit in a SmartClient), so
// they are launched via a tycho-surefire PDE run of the skilltest.tests project's
// 'integration' profile: Tycho boots a FULLY RESOLVED workbench from the target
// platform + reactor (so the IDE bundles resolve - unlike extracting the shipped
// tarball product), and only application_server is taken from the tarball. The
// SkillTestCiRunnerTest ignition then invokes the real SkillTestHeadlessRunner over
// the cloned baselines.

pipeline {
    agent any

    options {
        timeout(time: 90, unit: 'MINUTES')
        timestamps()
    }

    triggers {
        // Run at most once per day, at 03:00, and ONLY when the AI-plugin code
        // changed. pollSCM checks the repo at 03:00; if there are no new commits
        // it does NOT start a build at all (no success/failure record), unlike a
        // plain cron which would fire every day. The path filtering is done by the
        // GitSCM `includedRegions` on the SCM checkout below (Checkout stage), so a
        // commit that touches only docs/poms/other bundles is ignored by polling and
        // never starts a build. The three gated paths are the AI bundles:
        // com.servoy.eclipse.developer.mcp, com.servoy.eclipse.opencode and
        // com.servoy.eclipse.opencode.skilltest (SVY-21366).
        pollSCM('H 3 * * *')
    }

    environment {
        TEAMS_WEBHOOK = credentials('servoy-teams-webhook')
        // The reactor build runs the full Tycho lifecycle incl.
        // tycho-gpg-plugin:sign-p2-artifacts, which needs the signing key passphrase -
        // same as the main build Jenkinsfile.
        MAVEN_GPG_PASSPHRASE = credentials('servoy-gpg-passphrase')
    }

    tools {
        jdk 'Java 21'
        maven 'Maven 3.9.16'
    }

    stages {
        stage('Checkout') {
            steps {
                // Path-filtered checkout: `includedRegions` makes pollSCM ignore commits
                // that touch ONLY paths outside the three AI bundles, so polling starts a
                // build exclusively for in-path changes and leaves no build record for
                // off-path commits (SVY-21366). The regions are the SCM-relative paths of
                // the gated bundles. Everything else (branch, credentials, URL) is taken
                // from the job's own SCM config via `scm`, extended with the include filter.
                checkout([$class: 'GitSCM',
                    branches: scm.branches,
                    userRemoteConfigs: scm.userRemoteConfigs,
                    extensions: scm.extensions + [[$class: 'PathRestriction',
                        includedRegions: '''bundles/com.servoy.eclipse.developer.mcp/.*
bundles/com.servoy.eclipse.opencode/.*
bundles/com.servoy.eclipse.opencode.skilltest/.*''',
                        excludedRegions: '']]])
            }
        }

        stage('Checkout baselines') {
            // No per-stage gate: the daily poll (pollSCM + includedRegions, see triggers)
            // only STARTS a build when one of the three AI bundles changed, and a manual
            // "Build Now" is an explicit on-demand run. In both cases the scenarios should
            // run, so the stage runs unconditionally once the build has started. (The old
            // changeset gates were needed only because githubPush fired on every push,
            // including off-path/deploy-only commits; path-filtered polling removes that.)
            steps {
                // The baseline scenarios are curated by testers in a SEPARATE private repo
                // (Servoy/servoy-ai-skilltest-baselines) they have access to, independent of
                // this plugin source. Check it out (shallow; refreshed on re-runs) into a
                // sub-directory of the job workspace. The run points -Dservoy.skilltest.baselines
                // straight at ${WORKSPACE}/baselines-repo/baselines - no copy step.
                dir('baselines-repo') {
                    checkout([$class: 'GitSCM',
                        branches: [[name: '*/master']],
                        extensions: [[$class: 'CloneOption', shallow: true, depth: 1]],
                        userRemoteConfigs: [[
                            url: 'https://github.com/Servoy/servoy-ai-skilltest-baselines.git',
                            credentialsId: 'servoy-github-app']]])
                }
            }
        }

        stage('Checkout + zip skills (skill4servoy)') {
            // Runs unconditionally once the build has started - see 'Checkout baselines'.
            // Path-filtered polling (triggers) already ensures the build only starts for an
            // in-path AI-bundle change or a manual run.
            steps {
                // The Kiro path needs the SERVOY (not public/sample) skills: skill4servoy's
                // .opencode-shippable, zipped so SkillsZipExtractor extracts it into
                // ~/.servoy/opencode/. opencode_servoy.json is the kiro provider config
                // (model kiro/auto + @servoy/opencode-kiro-auth); it must land in the zip
                // ROOT as opencode.json so extractToConfigDir writes it as the active config
                // (and sets providerFromZip=true, so no litellm/GENAI provider is written).
                dir('skill4servoy') {
                    checkout([$class: 'GitSCM',
                        branches: [[name: '*/master']],
                        extensions: [[$class: 'CloneOption', shallow: true, depth: 1]],
                        userRemoteConfigs: [[
                            url: 'https://github.com/Servoy/skill4servoy.git',
                            credentialsId: 'servoy-github-app']]])
                }
                sh '''
                    rm -f "$WORKSPACE/skilltest-skills.zip"
                    cp "$WORKSPACE/skill4servoy/opencode_servoy.json" "$WORKSPACE/skill4servoy/.opencode-shippable/opencode.json"
                    # Use the JDK's jar (always present via the Java tool) rather than `zip`,
                    # which is not installed on the CI agent. -C zips entries relative to
                    # .opencode-shippable so opencode.json / skills/ land at the zip root.
                    rm -rf "$WORKSPACE/skill4servoy/.opencode-shippable/.opencode"
                    jar -cf "$WORKSPACE/skilltest-skills.zip" -C "$WORKSPACE/skill4servoy/.opencode-shippable" .
                '''
            }
        }

        stage('Run skill-test scenarios') {
            // Runs unconditionally once the build has started - see 'Checkout baselines'.
            // Path-filtered polling (triggers) already ensures the build only starts for an
            // in-path AI-bundle change or a manual run.
            steps {
                // KIRO_API_KEY is bound as an ENV VAR (not -D): the @servoy/opencode-kiro-auth
                // plugin in the opencode child process reads it from the environment, which the
                // surefire fork + opencode child inherit from this shell. The same key is also
                // passed as -DGENAI_API_KEY (see the mvn line) only to satisfy the opencode setup
                // gate; real auth is KIRO_API_KEY. cloud creds are no longer used (kept bound but
                // unused) now that the Kiro key skips the cloud login.
                // GIT_TOKEN: the git-source baselines clone a PRIVATE repo (Servoy/servoy_test)
                // over HTTPS via jgit. Headless, jgit must not fall back to EGit's UI credentials
                // provider (it calls a null workbench UI service -> "A null service reference is
                // not allowed", SVY-21366). SolutionSetup reads GIT_TOKEN and uses a
                // UsernamePasswordCredentialsProvider instead. Reuse the same GitHub App
                // credential the checkouts use; its password/token is the clone token.
                withCredentials([
                        string(credentialsId: 'servoy-kiro-api-key', variable: 'KIRO_API_KEY'),
                        usernamePassword(credentialsId: 'servoy-github-app',
                        usernameVariable: 'GIT_USER', passwordVariable: 'GIT_TOKEN')]) {
                    wrap([$class: 'Xvfb', installationName: 'xvfb', autoDisplayName: true]) {
                      // Quiet the headless GTK/SWT noise that otherwise floods the console:
                      // SWT drives GTK off-screen under Xvfb, and GTK emits benign
                      // 'Gtk-CRITICAL ... gtk_box_gadget_distribute: assertion size >= 0'
                      // (and a11y/at-spi) messages to stderr for zero-size offscreen widgets.
                      // These are cosmetic, not test failures. NO_AT_BRIDGE=1 drops the
                      // accessibility-bus warnings; G_MESSAGES_DEBUG= (empty) enables no GLib
                      // debug domains; GTK_MODULES= clears any auto-loaded a11y module. This is
                      // the env-only approach (SVY-21366) - it does not touch the test output.
                      withEnv(['NO_AT_BRIDGE=1', 'G_MESSAGES_DEBUG=', 'GTK_MODULES=']) {
                        configFileProvider([
                            configFile(fileId: 'ba7b9372-76e5-4898-a2be-1dde60a0d6e3', variable: 'MAVEN_SETTINGS'),
                            configFile(fileId: 'maven_toolchain', variable: 'TOOLCHAIN')
                        ]) {
                            // One invocation. -Pintegration builds the 3 AI bundles from source,
                            // extracts only application_server/** from the tarball, and runs
                            // SkillTestCiRunnerTest under a tycho-surefire workbench (resolved from
                            // the target platform). That ignition calls the real
                            // SkillTestHeadlessRunner over the cloned baselines and writes
                            // TEST-skilltest.xml. -Dservoy.skilltest.run=true un-skips the ignition.
                            // The 3 AI bundle modules are listed explicitly (not -am): the test
                            // plugin is a FRAGMENT of com.servoy.eclipse.opencode.skilltest, an OSGi
                            // (not Maven) dependency, so -am would not pull the host bundle into the
                            // reactor and Tycho could not resolve it at the reactor qualifier.
                            // kiroApiKey -> -DGENAI_API_KEY (gate only); the real Kiro auth uses the
                            // KIRO_API_KEY env var bound above. skillsZip is the skill4servoy
                            // .opencode-shippable bundle zipped in the previous stage.
                            sh '''mvn -B -s "$MAVEN_SETTINGS" -t "$TOOLCHAIN" \
                                clean verify \
                                -Pintegration \
                                -pl bundles/com.servoy.eclipse.opencode,bundles/com.servoy.eclipse.developer.mcp,bundles/com.servoy.eclipse.opencode.skilltest,tests/com.servoy.eclipse.opencode.skilltest.tests \
                                -Dtycho.localArtifacts=ignore \
                                -Dservoy.url=file:///data/www/latest/servoy_lts_2026/update_site/ \
                                -Dservoy.install.tarball.for.appserver=/data/www/latest/servoy_lts_2026/servoy_linux.tar.gz \
                                -Dservoy.skilltest.run=true \
                                -Dservoy.skilltest.baselines="$WORKSPACE/baselines-repo/baselines" \
                                -Dservoy.skilltest.outputDir="$WORKSPACE/skilltest-reports" \
                                -Dservoy.skilltest.kiroApiKey="$KIRO_API_KEY" \
                                -Dservoy.skilltest.skillsZip="$WORKSPACE/skilltest-skills.zip"'''
                        }
                      }
                    }
                }
            }
            post {
                always {
                    // The runner writes TEST-skilltest.xml to -Dservoy.skilltest.outputDir;
                    // tycho-surefire also writes its own surefire reports. allowEmptyResults:false
                    // so a run that produced NO report (e.g. the workbench never came up) fails the
                    // build instead of a silent SUCCESS.
                    // Capture the workbench's own log + opencode output BEFORE the next
                    // `clean` wipes target/. The opencode setup (OpencodeFolderCreatorJob,
                    // RunOpencodeCommand, kiro-auth) logs via ServoyLog to the Eclipse
                    // .metadata/.log, which the Jenkins console does NOT show - this is where
                    // "opencode server did not become ready" has its real cause.
                    //
                    // Copy the DOT-named logs to non-dot names first: Jenkins archiveArtifacts
                    // applies Ant "default excludes" which skip .* paths (.metadata, .log), so a
                    // direct glob of **/.metadata/.log silently matches nothing. We copy to
                    // plain names under $WORKSPACE/skilltest-logs and archive THAT.
                    sh '''
                        set +e
                        mkdir -p "$WORKSPACE/skilltest-logs"
                        find "$WORKSPACE" -path '*/target/work/data/.metadata/.log' -exec cp {} "$WORKSPACE/skilltest-logs/workbench.log" \\; 2>/dev/null
                        find "$WORKSPACE" -path '*/target/work/**' -name '*.log' 2>/dev/null | while read f; do
                            cp "$f" "$WORKSPACE/skilltest-logs/$(echo "$f" | tr '/.' '__')" 2>/dev/null
                        done
                        echo "collected logs:"; ls -la "$WORKSPACE/skilltest-logs" 2>/dev/null
                    '''
                    archiveArtifacts artifacts: 'skilltest-logs/**, skilltest-reports/**',
                                     allowEmptyArchive: true, fingerprint: false
                    junit allowEmptyResults: false,
                          testResults: 'skilltest-reports/TEST-*.xml, **/target/surefire-reports/TEST-*.xml'
                }
            }
        }

        stage('Deploy skilltest p2 site') {
            // Deploy only runs when the build itself ran, and the build only STARTS for an
            // in-path AI-bundle change (daily poll) or a manual run - so there is no separate
            // "skip when unchanged" gate needed here: an unchanged day never starts a build,
            // so this stage never executes on a no-change day (SVY-21366).
            steps {
                // Build + publish the internal skilltest update site to
                // build.servoy.com/latest/servoy_ai_skilltest/. Separate invocation because the
                // scenario run above only builds the test project + its deps, not the site.
                configFileProvider([
                    configFile(fileId: 'ba7b9372-76e5-4898-a2be-1dde60a0d6e3', variable: 'MAVEN_SETTINGS'),
                    configFile(fileId: 'maven_toolchain', variable: 'TOOLCHAIN')
                ]) {
                    // List the feature + bundle modules explicitly: the site needs the
                    // skilltest FEATURE (an OSGi/p2 requirement), which -am does not pull in.
                    sh '''mvn -B -s "$MAVEN_SETTINGS" -t "$TOOLCHAIN" \
                        clean package \
                        -pl bundles/com.servoy.eclipse.opencode,bundles/com.servoy.eclipse.developer.mcp,bundles/com.servoy.eclipse.opencode.skilltest,features/com.servoy.eclipse.opencode.skilltest.feature,repository.site_skilltest \
                        -Dtycho.localArtifacts=ignore \
                        -Dservoy.url=file:///data/www/latest/servoy_lts_2026/update_site/'''
                    sh '''
                    rm -rf /data/www/latest/servoy_ai_skilltest/
                    mkdir -p /data/www/latest/servoy_ai_skilltest/
                    for d in repository.site_skilltest/target/repository/; do
                        [ -d "$d" ] && cp -r "$d/." "/data/www/latest/servoy_ai_skilltest/"
                        break
                    done
                    '''
                }
            }
        }
    }

    post {
        failure {
            office365ConnectorSend webhookUrl: TEAMS_WEBHOOK, status: 'Failed', adaptiveCards: true
        }
        unstable {
            office365ConnectorSend webhookUrl: TEAMS_WEBHOOK, status: 'Unstable', adaptiveCards: true
        }
        fixed {
            office365ConnectorSend webhookUrl: TEAMS_WEBHOOK, status: 'Back to Normal', adaptiveCards: true
        }
    }
}
