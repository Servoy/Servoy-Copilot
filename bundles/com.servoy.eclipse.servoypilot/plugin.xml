<extension
      point="com.servoy.eclipse.core.aiprovider">
   <aiprovider
         class="com.servoy.eclipse.servoypilot.ai.AIModelProvider"
         id="com.servoy.eclipse.servoypilot.aiprovider1">
   </aiprovider>
</extension>

   <!-- Servoy AI Context Menu Commands -->
   <extension
         point="org.eclipse.ui.commands">
      <category
            id="com.servoy.eclipse.servoypilot.commands.category"
            name="Servoy AI">
      </category>
      <command
            category="com.servoy.eclipse.servoypilot.commands.category"
            id="com.servoy.eclipse.servoypilot.context.debug"
            name="Debug">
      </command>
      <command
            category="com.servoy.eclipse.servoypilot.commands.category"
            id="com.servoy.eclipse.servoypilot.context.review"
            name="Review">
      </command>
      <command
            category="com.servoy.eclipse.servoypilot.commands.category"
            id="com.servoy.eclipse.servoypilot.context.generateDocs"
            name="Generate Docs">
      </command>
      <command
            category="com.servoy.eclipse.servoypilot.commands.category"
            id="com.servoy.eclipse.servoypilot.context.generateTests"
            name="Generate Tests">
      </command>
      <command
            category="com.servoy.eclipse.servoypilot.commands.category"
            id="com.servoy.eclipse.servoypilot.context.explain"
            name="Explain">
      </command>
      <command
            category="com.servoy.eclipse.servoypilot.commands.category"
            id="com.servoy.eclipse.servoypilot.context.querybuilder"
            name="Query Builder">
      </command>
   </extension>

   <!-- Servoy AI Context Menu Handlers -->
   <extension
         point="org.eclipse.ui.handlers">
      <handler
            class="com.servoy.eclipse.servoypilot.context.ServoyAiContextMenuHandler"
            commandId="com.servoy.eclipse.servoypilot.context.debug">
      </handler>
      <handler
            class="com.servoy.eclipse.servoypilot.context.ServoyAiContextMenuHandler"
            commandId="com.servoy.eclipse.servoypilot.context.review">
      </handler>
      <handler
            class="com.servoy.eclipse.servoypilot.context.ServoyAiContextMenuHandler"
            commandId="com.servoy.eclipse.servoypilot.context.generateDocs">
      </handler>
      <handler
            class="com.servoy.eclipse.servoypilot.context.ServoyAiContextMenuHandler"
            commandId="com.servoy.eclipse.servoypilot.context.generateTests">
      </handler>
      <handler
            class="com.servoy.eclipse.servoypilot.context.ServoyAiContextMenuHandler"
            commandId="com.servoy.eclipse.servoypilot.context.explain">
      </handler>
      <handler
            class="com.servoy.eclipse.servoypilot.context.ServoyAiContextMenuHandler"
            commandId="com.servoy.eclipse.servoypilot.context.querybuilder">
      </handler>
   </extension>

   <!-- Servoy AI Context Menu Contribution -->
   <extension
         point="org.eclipse.ui.menus">
      <menuContribution
            locationURI="popup:org.eclipse.ui.popup.any?after=additions">
         <dynamic
               class="com.servoy.eclipse.servoypilot.context.ServoyAiContextMenu"
               id="com.servoy.eclipse.servoypilot.contextmenu.dynamic">
         </dynamic>
      </menuContribution>
   </extension>

	<extension point="org.eclipse.ui.ide.markerResolution">
		<markerResolutionGenerator
			markerType="org.eclipse.dltk.javascript.core.jsproblem"
			class="com.servoy.eclipse.servoypilot.context.ServoyAIQuickFixGenerator" />
	</extension>
	
	<extension point="org.eclipse.dltk.ui.correctionProcessor">
     <correctionProcessor
            class="com.servoy.eclipse.servoypilot.context.ServoyAICorrectionProcessor"
            nature="org.eclipse.dltk.javascript.core.nature">
      </correctionProcessor>
</extension>
</plugin>
