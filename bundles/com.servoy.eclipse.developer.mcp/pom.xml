<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.servoy</groupId>
        <artifactId>com.servoy.eclipse.servoypilot.parent</artifactId>
        <version>2026.3.1-SNAPSHOT</version>
        <relativePath>../..</relativePath>
    </parent>
    <artifactId>com.servoy.eclipse.developer.mcp</artifactId>
    <packaging>eclipse-plugin</packaging>

    <profiles>
        <!-- JaCoCo report step (SVY: coverage recipe), activated with -Pcoverage-report.
             Run AFTER a reactor build that executed the tests (which wrote the exec file in
             the com.servoy.eclipse.developer.mcp.tests module). This profile analyzes THIS
             bundle's own compiled classes (target/classes = the production code) and its
             sources, reading the coverage data recorded by the test fork. It is a separate
             step because this bundle builds BEFORE the test module in reactor order, so the
             exec file does not yet exist during this module's own lifecycle.

             Usage (from the repo root):
               mvn clean verify -Dtycho.localArtifacts=ignore -Dmaven.test.failure.ignore=true \
                   -pl bundles/com.servoy.eclipse.developer.mcp,tests/com.servoy.eclipse.developer.mcp.tests -am
               mvn -Pcoverage-report org.jacoco:jacoco-maven-plugin:merge org.jacoco:jacoco-maven-plugin:report \
                   -pl bundles/com.servoy.eclipse.developer.mcp -Dtycho.localArtifacts=ignore -o
             Output: bundles/com.servoy.eclipse.developer.mcp/target/site/jacoco/jacoco.xml (and html).

             Phase 2: coverage now merges BOTH exec files from the test module - jacoco.exec
             (plainjunit) and jacoco-it.exec (integrationpde PDE tests, written only when the
             integration profile ran). The 'merge' goal combines whichever exist into
             target/jacoco-merged.exec; the 'report' goal analyzes this bundle's own classes
             against that merged data. One plugin-level <configuration> serves both direct goals:
             'merge' reads <fileSets>/<destFile> and ignores <dataFile>; 'report' reads <dataFile>
             and ignores the fileSets - so they do not conflict and the Jenkins invocation stays a
             simple 'merge report' goal pair. A missing jacoco-it.exec is harmless (merge just
             takes what is there), so this works for a plainjunit-only run too. -->
        <profile>
            <id>coverage-report</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>0.8.13</version>
                        <configuration>
                            <!-- 'merge' inputs: the unit + integration exec files produced by the
                                 test module's forked JVMs. A listed file that does not exist is
                                 simply skipped. -->
                            <fileSets>
                                <fileSet>
                                    <directory>${project.basedir}/../../tests/com.servoy.eclipse.developer.mcp.tests/target</directory>
                                    <includes>
                                        <include>jacoco.exec</include>
                                        <include>jacoco-it.exec</include>
                                    </includes>
                                </fileSet>
                            </fileSets>
                            <!-- 'merge' output (ignored by 'report'). -->
                            <destFile>${project.build.directory}/jacoco-merged.exec</destFile>
                            <!-- 'report' input (ignored by 'merge'): the merged data. -->
                            <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
                            <outputDirectory>${project.build.directory}/site/jacoco</outputDirectory>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
