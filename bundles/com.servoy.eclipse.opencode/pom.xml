<?xml version="1.0" encoding="UTF-8"?>
<project
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
	xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.servoy</groupId>
		<artifactId>com.servoy.eclipse.servoypilot.parent</artifactId>
		<version>2026.3.1-SNAPSHOT</version>
		<relativePath>../..</relativePath>
	</parent>
	<artifactId>com.servoy.eclipse.opencode</artifactId>
	<packaging>eclipse-plugin</packaging>
	<build>
		<plugins>
			<!-- Build the Angular chat UI (webui/) into webui-dist/ at build time.
			     Self-contained: downloads a pinned node+npm into target/; independent
			     of the runtime npm/node Servoy ships for launching opencode. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-clean-plugin</artifactId>
				<configuration>
					<filesets>
						<fileset>
							<directory>webui-dist</directory>
						</fileset>
					</filesets>
				</configuration>
			</plugin>
			<plugin>
				<groupId>com.github.eirslett</groupId>
				<artifactId>frontend-maven-plugin</artifactId>
				<version>1.15.4</version>
				<configuration>
					<workingDirectory>webui</workingDirectory>
					<installDirectory>target</installDirectory>
				</configuration>
				<executions>
					<!-- 1. Install node and npm locally into target/ -->
					<execution>
						<id>install node and npm</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>install-node-and-npm</goal>
						</goals>
						<configuration>
							<!-- Node 24 LTS. Must satisfy the Angular devkit engine
							     requirement (>= ^24.15.0); v24.11.1 was too old. -->
							<nodeVersion>v24.21.0</nodeVersion>
						</configuration>
					</execution>

					<!-- 2. npm ci -->
					<execution>
						<id>npm ci</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>npm</goal>
						</goals>
						<configuration>
							<arguments>ci</arguments>
						</configuration>
					</execution>

					<!-- 3. ng build (production) -> ../webui-dist -->
					<execution>
						<id>ng build</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>npm</goal>
						</goals>
						<configuration>
							<arguments>run build</arguments>
						</configuration>
					</execution>

					<!-- 4. Angular Vitest tests with V8 coverage (writes ../target/coverage:
					     cobertura + lcov + html + json-summary). Jenkins publishes the cobertura
					     report via recordCoverage. Skipped when tests are skipped.
					     testFailureIgnore: a webui test problem (incl. vitest exiting non-zero on
					     stray unhandled async errors even when all tests pass) must NOT fail the
					     whole product build - mirrors the Java side's -Dmaven.test.failure.ignore.
					     The coverage report is still written, and the build proceeds so Jenkins'
					     Coverage Report stage can publish it. -->
					<execution>
						<id>webui vitest coverage</id>
						<phase>test</phase>
						<goals>
							<goal>npm</goal>
						</goals>
						<configuration>
							<skip>${maven.test.skip}</skip>
							<testFailureIgnore>true</testFailureIgnore>
							<arguments>run test:coverage</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- JaCoCo report step (SVY: coverage recipe), activated with -Pcoverage-report.
		     Run AFTER a reactor build that executed the tests (which wrote the exec file in
		     the sibling .tests fragment). This profile analyzes THIS bundle's own compiled
		     classes (target/classes = the production code) and its sources, reading the
		     coverage data recorded by the fragment's test fork. It is a separate step because
		     this host bundle builds BEFORE the test fragment in reactor order, so the exec
		     file does not yet exist during this module's own lifecycle.

		     Usage (from the repo root):
		       mvn clean verify -Dtycho.localArtifacts=ignore -Dmaven.test.failure.ignore=true \
		           -pl bundles/com.servoy.eclipse.opencode,tests/com.servoy.eclipse.opencode.tests -am
		       mvn -Pcoverage-report org.jacoco:jacoco-maven-plugin:merge org.jacoco:jacoco-maven-plugin:report \
		           -pl bundles/com.servoy.eclipse.opencode -Dtycho.localArtifacts=ignore -o
		     Output: bundles/com.servoy.eclipse.opencode/target/site/jacoco/jacoco.xml (and html).

		     Phase 2: coverage now merges BOTH exec files from the test fragment - jacoco.exec
		     (plainjunit) and jacoco-it.exec (integrationpde PDE tests, written only when the
		     integration profile ran). The 'merge' goal combines whichever exist into
		     target/jacoco-merged.exec; the 'report' goal analyzes this bundle's own classes
		     against that merged data. One plugin-level <configuration> serves both direct goals:
		     'merge' reads <fileSets>/<destFile> and ignores <dataFile>; 'report' reads <dataFile>
		     and ignores the fileSets - so they do not conflict and the Jenkins invocation stays a
		     simple 'merge report' goal pair. A missing jacoco-it.exec is harmless (merge just
		     takes what is there), so this works for a plainjunit-only run too. -->
		<profile>
			<id>coverage-report</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.jacoco</groupId>
						<artifactId>jacoco-maven-plugin</artifactId>
						<version>0.8.13</version>
						<configuration>
							<!-- 'merge' inputs: the unit + integration exec files produced by the
							     test fragment's forked JVMs. A listed file that does not exist is
							     simply skipped. -->
							<fileSets>
								<fileSet>
									<directory>${project.basedir}/../../tests/com.servoy.eclipse.opencode.tests/target</directory>
									<includes>
										<include>jacoco.exec</include>
										<include>jacoco-it.exec</include>
									</includes>
								</fileSet>
							</fileSets>
							<!-- 'merge' output (ignored by 'report'). -->
							<destFile>${project.build.directory}/jacoco-merged.exec</destFile>
							<!-- 'report' input (ignored by 'merge'): the merged data. -->
							<dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
							<outputDirectory>${project.build.directory}/site/jacoco</outputDirectory>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
