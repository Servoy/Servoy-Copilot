# npm counterpart of the pnpm allowBuilds approval (SVY-21679). Recent npm blocks
# dependency install/lifecycle scripts by default; @opencode/cli's postinstall must run
# to materialize the real native opencode binary. This re-enables lifecycle scripts for
# this managed, first-party, pinned install dir only (it is a no-op on an npm that still
# runs scripts by default). Keep in sync with pnpm-workspace.yaml and package.json.
ignore-scripts=false
